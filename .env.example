# ==========================================
# METRION ENVIRONMENT CONFIGURATION
# ==========================================

# Core Application Security
SECRET_KEY=metrion_secret_key_sih2026_super_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# For SQLite (default, zero configuration needed for local demo):
DATABASE_URL=sqlite:///./metrion.db
# For PostgreSQL (production deployment):
# DATABASE_URL=postgresql://metrion_user:metrion_password@localhost:5432/metrion_db

# Verification Base URL (embedded in generated QR codes on statutory certificates)
BASE_VERIFY_URL=http://localhost:5173/verify

# File Storage Directory (relative or absolute path for evidence and generated PDFs)
STORAGE_DIR=./uploads

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Demo Mode Flag (enforces statutory disclaimers on all generated outputs)
IS_DEMO_ENVIRONMENT=true
